// x -- x //
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Products & Skus //

model Product { 
  id          String   @id @default(uuid())
  name        String   
  description String?  
  basePrice   Decimal  @db.Decimal(8,2) // 8 dig en total, donde 2 son decimales 
  isActive    Boolean  @default(true)

  // Relacion 
  skus        Sku[] // 1 -> N // modelado desde RAM (los datos vienen del servidor de postgre)
 
  // Timestamps
  createdAt   DateTime  @default(now())  
  updateAt    DateTime  @updatedAt

  @@map("products")
}

model Sku { 
  id         String   @id      @default(uuid())
  skuCode    String   @unique
  size       String
  color      String
  stockDisp  Int
  stockMin   Int?

  productId  String // [F.K] escalar, crea una tabla con ese id de refercia 
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade) // data, no ocupa espacio. Verlo como un "cordon" que relaciona dos "objetos" separados entre si.

  // UN SKU PERTENECE A UN CARTITEM?
  cartItmes  CartItem[] 
  orderItems OrderItem []
  // History
  createdAt  DateTime  @default(now())
  updateAt   DateTime  @updatedAt

  @@map("skus")
}

// users & role //

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id        String    @id @default(uuid())
  dni       String
  nameUser  String
  name      String
  lastName  String
  phone     String

  role      Role      @default(CUSTOMER) // Es solo asignacion
  cart      Cart?     // es en si un campo se user? o mas bien de un USER que es customer?
  orders    Order[]   // un usario puede tener muchas compras en un periodo de tiempo

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // falta trabajar permisos, cliente o admin
  @@map("users")
}

// cart & cart item //

model Cart {
  id        String    @id   @default(uuid())

  // Rel 1 a 1. UN usuario tiene UN carrito activo
  userId    String    @unique // FK (ocupa esp, es visible)
  user      User      @relation(fields: [userId], references: [id]) //relation field (no ocupa esp, no es visible)
  
  // Rel 1 a N. UN carrito puede tener MUCHOS items ( prod + SKU )
  items     CartItem[] // UN caerrito puede teber muchos cart_items 

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("carts")
}

model       CartItem { // se relaciona con el SKU (lo fisico de producto) - y desde alli se puede acceder a Producto para el resto de informacion
  id        String    @id @default(uuid()) 
  quantity  Int       @default(1)

  // relacion cart
  cartId    String    // FK - lo "une a su carrito correspondiente"
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade) 

  // relacion al SKU
  skuId     String
  sku       Sku       @relation(fields: [skuId], references: [id]) // ¿ Por qué no iría onDelate: Cascade ? 

  createdAt DateTime  @default(now())
  updateAt  DateTime  @updatedAt

  @@map("cart_items")
}

// Orden de compra

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  COMPLETED
  FULFILLED
}

model Order { // resumen general de compra
    id       String        @id @default(uuid()) 
  
    userId   String // pregunta importante userId seía FK de user ?
    user     User         @relation(fields: [userId], references: [id]) // traeme el user con id "userId"
    items    OrderItem [] // un Order (Padre) puede contener uno o mas order_items(sub-ticktes)

    amount   Decimal      @db.Decimal(8,2) // en el order superior va el total gral.

    status   OrderStatus  @default(PENDING) // Estado de la compra  (pendiente - pagao, caneclado, finalizado)
    
    createdAt  DateTime    @default(now())
    updatedAt DateTime    @updatedAt
       
  @@map("orders")
}

model OrderItem { // lo entiendo como el total por cada item grupo de items del mismo tipo
  id         String  @id @default(uuid()) // order_item_di 4

  quantity   Int     @default(1) // ej cant = 3

  priceUnity Decimal @db.Decimal(8,2)   // congelo precio

  // relacion con la orden padre
  orderId    String // FK de order
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade) // relation field

  skuId      String // FK de sku
  sku        Sku     @relation(fields: [skuId], references: [id]) // relation field

  @@map("order_items")
}

